#!/bin/bash

# PATH-shim over /usr/share/omarchy/bin/omarchy-theme-set-tmux (2026-08-22).
# Identical behavior EXCEPT: never sets tmux window-style / window-active-style.
# The stock script paints every pane with the theme's solid background color,
# which breaks transparent terminals and caused a visible dark flash on each
# wallpaper/theme change. Panes inherit the terminal's (transparent) background
# instead; pane CONTENT colors still come from the OSC palette sync below.
# Review after omarchy updates: diff against the packaged script.

CURRENT_THEME_PATH="$HOME/.local/state/omarchy/current/theme"
GUM_ENV="$CURRENT_THEME_PATH/gum_env.lua"
COLORS_TOML="$CURRENT_THEME_PATH/colors.toml"

if ! tmux list-sessions >/dev/null 2>&1; then
  exit 0
fi

set_tmux_environment() {
  local key="$1"
  local value="$2"
  local session

  tmux set-environment -g "$key" "$value" 2>/dev/null || return 0

  while IFS= read -r session; do
    [[ -n $session ]] || continue
    tmux set-environment -t "$session" "$key" "$value" 2>/dev/null || true
  done < <(tmux list-sessions -F "#{session_id}" 2>/dev/null)
}

sync_theme_environment() {
  local key value

  [[ -f $GUM_ENV ]] || return

  while IFS=$'\t' read -r key value; do
    [[ -n $key && -n $value ]] || continue
    set_tmux_environment "$key" "$value"
  done < <(awk -F'"' '/hl\.env\("[A-Z0-9_]+", "[^"]+"\)/ { print $2 "\t" $4 }' "$GUM_ENV")
}

sync_colorfgbg() {
  local colorfgbg="15;0"

  if [[ $(theme_color mode) == "light" ]]; then
    colorfgbg="0;15"
  fi

  set_tmux_environment COLORFGBG "$colorfgbg"
}

theme_osc_sequences() {
  omarchy-theme-osc "$COLORS_TOML"
}

theme_color() {
  omarchy-theme-color --file "$COLORS_TOML" "$@"
}

sync_tmux_window_style() {
  local cursor

  [[ -f $COLORS_TOML ]] || return

  # Transparency-safe: make sure no solid pane background is ever active,
  # clearing any stale value BEFORE clients get refreshed further down.
  tmux set-option -g window-style "" 2>/dev/null || true
  tmux set-option -g window-active-style "" 2>/dev/null || true

  cursor=$(theme_color cursor)
  if [[ -n $cursor ]]; then
    tmux set-option -g cursor-colour "$cursor" 2>/dev/null || true
  fi
}

# Replaces the stock sync_tmux_pane_colors. The stock version writes the full
# OSC palette (incl. OSC 11 background) into every pane tty, which (a) flashes
# a solid background on transparent terminals until the terminal's own config
# reload restores opacity, and (b) pins a per-pane palette in tmux so colors
# already rendered on screen stop following the terminal's live palette.
# The terminal itself (kitty via config include + SIGUSR1) is the single
# source of palette truth; here we only RESET any pinned pane palette so the
# terminal's colors apply everywhere, old output included.
sync_tmux_pane_colors() {
  local pane_tty
  # OSC 104 = reset color palette, OSC 110/111/112 = reset fg/bg/cursor
  local osc_reset='\033]104\007\033]110\007\033]111\007\033]112\007'

  while IFS= read -r pane_tty; do
    [[ $pane_tty == /dev/pts/* ]] || continue
    printf '%b' "$osc_reset" >"$pane_tty" 2>/dev/null || true
  done < <(tmux list-panes -a -F "#{pane_tty}" 2>/dev/null | sort -u)
}

signal_tmux_panes() {
  local pane_tty tpgid

  while IFS= read -r pane_tty; do
    [[ $pane_tty == /dev/pts/* ]] || continue
    tpgid=$(ps -o tpgid= -t "${pane_tty#/dev/}" 2>/dev/null | awk 'NF && $1 > 0 { print $1; exit }')
    [[ -n $tpgid ]] || continue
    kill -WINCH "-$tpgid" 2>/dev/null || true
  done < <(tmux list-panes -a -F "#{pane_tty}" 2>/dev/null | sort -u)
}

# Re-source the matugen-generated status-bar colors (tmux.conf loads them at
# server start; this picks up regenerated values on every theme change).
# Single owner of the live tmux reload — quattro.toml has no tmux post_hook.
sync_tmux_status_colors() {
  local status_conf="$HOME/.config/matugen/generated/tmux-colors.conf"

  [[ -f $status_conf ]] || return 0
  tmux source-file -q "$status_conf" 2>/dev/null || true
}

refresh_tmux_clients() {
  local client

  while IFS= read -r client; do
    [[ -n $client ]] || continue
    tmux refresh-client -t "$client" 2>/dev/null || true
  done < <(tmux list-clients -F "#{client_name}" 2>/dev/null)
}

sync_theme_environment
sync_colorfgbg
sync_tmux_window_style
sync_tmux_status_colors
sync_tmux_pane_colors
signal_tmux_panes
refresh_tmux_clients
