[Unit]
Description=Periodic wallpaper rotation for omarchy-auto-theme

# Placeholder schedule so the unit always loads cleanly; the drop-in
# omarchy-bg-rotate.timer.d/interval.conf (generated from the ROTATE setting
# by omarchy-matugen-sync) resets and replaces it. The timer is only ever
# enabled while ROTATE is set.
[Timer]
OnActiveSec=30m
OnUnitActiveSec=30m

[Install]
WantedBy=timers.target
