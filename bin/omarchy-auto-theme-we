#!/bin/bash
# Wallpaper Engine glue for omarchy-auto-theme.
#
# Usage:
#   omarchy-auto-theme-we <workshop-id|project-dir|image|video> [-- command...]
#   omarchy-auto-theme-we import [--remove|--refresh] [id...]
#   omarchy-auto-theme-we --exec-current
#
# Target mode: resolve the target to a still image (a project's preview file;
# a frame extracted with ffmpeg for animated sources) and render it through
# `omarchy-matugen-sync --image`. With a trailing command, any running
# linux-wallpaperengine instance is stopped and the command is exec'd after
# the colors are in place, so one keybind swaps wallpaper and theme together:
#
#   omarchy-auto-theme-we 123456 -- linux-wallpaperengine --screen-root DP-1 --bg 123456
#
# import: materialize one still per installed workshop project into the
# matugen-auto background collection as we-<id>.<ext>, so Wallpaper Engine
# wallpapers appear in omarchy's native SUPER+CTRL+SPACE grid. Picking one
# there makes omarchy-matugen-sync render the palette from the still and
# start omarchy-we.service, which launches the live wallpaper on top.
#
# --exec-current: unit entry point (omarchy-we.service). Reads the current
# background symlink; if it is a we-<id> entry, execs linux-wallpaperengine
# for that id (exits 0 otherwise, so autostart no-ops on static wallpapers).
set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$HOME/.local/bin:$OMARCHY_PATH/bin:/usr/local/bin:/usr/bin:$PATH"

# Steam's workshop content dir for Wallpaper Engine (app id 431960).
WE_WORKSHOP_DIR="${WE_WORKSHOP_DIR:-$HOME/.local/share/Steam/steamapps/workshop/content/431960}"
# Steam's workshop manifest for the app: its WorkshopItemDetails section
# tracks the live subscription list, updated the moment the user
# (un)subscribes - while the content dirs above are garbage-collected
# lazily and can linger long after an unsubscribe.
WE_ACF="${WE_ACF:-$HOME/.local/share/Steam/steamapps/workshop/appworkshop_431960.acf}"
FRAME="$HOME/.cache/omarchy-auto-theme/we-frame.png"
BG_DIR="$HOME/.config/omarchy/backgrounds/matugen-auto"
# Manifest of the stills import created: line 1 is the import mode
# ("all" or "selected"), the rest are basenames. Refreshes and uninstall
# touch only listed names; anything else in the dir is the user's.
WE_MANIFEST="$BG_DIR/.omarchy-auto-theme-we"
SETTINGS="$HOME/.config/omarchy-auto-theme/settings"
# Best-still cache: one full-res frame per workshop id, captured by the
# launcher (--screenshot on first launch) or extracted from a video source
# at import. Workshop previews are small squares that look blurry and zoomed
# when cover-cropped onto a real monitor; a cached frame replaces them and
# survives refreshes, so an upgraded still is never downgraded back.
SHOTS="$HOME/.cache/omarchy-auto-theme/we-shots"
# linux-wallpaperengine as pgrep/pkill -x sees it: the kernel truncates comm
# to 15 chars ("linux-wallpaper"); accept the full name too in case that ever
# changes. Matched against comm, never against the command line (-f): the
# `-- /usr/bin/linux-wallpaperengine ...` relaunch form puts the binary's
# path into THIS script's argv, and a cmdline match would kill the wrapper
# itself between the pkill and the exec.
WE_PROC='linux-wallpaper(engine)?'

usage() {
  cat <<EOF
Usage: omarchy-auto-theme-we <workshop-id|project-dir|image|video> [-- command...]
       omarchy-auto-theme-we import [--remove|--refresh] [id...]
       omarchy-auto-theme-we capture
       omarchy-auto-theme-we --exec-current
EOF
}
fail() {
  echo "omarchy-auto-theme-we: $*" >&2
  exit 1
}
note() { echo "omarchy-auto-theme-we: $*" >&2; }

# Resolve a project dir to its preview file (empty if none). Every Wallpaper
# Engine project ships a preview next to project.json; order prefers stills.
find_preview() { # dir
  local name
  for name in preview.jpg preview.jpeg preview.png preview.webp preview.bmp preview.gif; do
    [[ -f $1/$name ]] && { echo "$1/$name"; return 0; }
  done
  return 1
}

# Extract a representative frame from an animated source into $2 (a jpg).
# -vf thumbnail picks a representative frame instead of frame 0, which for
# scene/video wallpapers is often black or mid-fade-in.
extract_frame() { # src, out
  command -v ffmpeg >/dev/null || return 1
  ffmpeg -loglevel error -y -i "$1" -vf thumbnail -frames:v 1 "$2"
}

# --- import: sync workshop projects into the background collection ---------
# The currently subscribed workshop ids per Steam's manifest; nonzero when
# the manifest is missing or unparseable (callers then trust the dirs).
subscribed_ids() {
  [[ -f $WE_ACF ]] || return 1
  local ids
  ids=$(awk '/"WorkshopItemDetails"/{f=1;next} f && /^\t\t"[0-9]+"$/ {gsub(/[\t"]/,""); print}' "$WE_ACF" 2>/dev/null)
  [[ -n $ids ]] || return 1
  printf '%s\n' "$ids"
}

manifest_entries() { # -> stdout: basenames from the manifest (may be empty)
  [[ -f $WE_MANIFEST ]] && tail -n +2 "$WE_MANIFEST" || true
}

remove_entries() { # basenames...
  local name
  for name in "$@"; do
    # Manifest lines are basenames we wrote; refuse anything path-like.
    [[ -n $name && $name != */* ]] || continue
    rm -f "$BG_DIR/$name" 2>/dev/null || note "could not remove $BG_DIR/$name"
  done
  return 0
}

write_manifest() { # mode, basenames...
  local mode=$1
  shift
  {
    echo "$mode"
    (($# > 0)) && printf '%s\n' "$@"
  } >"$WE_MANIFEST.tmp.$$"
  mv -f "$WE_MANIFEST.tmp.$$" "$WE_MANIFEST"
}

# Materialize the still for one workshop id into $BG_DIR. Prints the basename
# it created on success; returns 1 (printing nothing) when the project is
# missing or unusable, so the caller drops it from the manifest. OWNED (set
# by do_import from the old manifest) marks names we may overwrite: a
# pre-existing file we never created is the user's and stays untouched.
import_one() { # id
  local id=$1 dir=$WE_WORKSHOP_DIR/$1 src ext dst name best=$SHOTS/$1.jpg old
  [[ -d $dir ]] || return 1
  # Video wallpapers: the project's video is full wallpaper resolution while
  # the preview is a small square; fill the cache from the real source once.
  # (project.json's type is case-inconsistent in the wild: "Video"/"video".)
  if [[ ! -f $best && -f $dir/project.json ]] \
     && command -v jq >/dev/null && command -v ffmpeg >/dev/null; then
    local ptype pfile
    ptype=$(jq -r '.type // empty' "$dir/project.json" 2>/dev/null || true)
    pfile=$(jq -r '.file // empty' "$dir/project.json" 2>/dev/null || true)
    if [[ ${ptype,,} == video && -n $pfile && -f $dir/$pfile ]]; then
      mkdir -p "$SHOTS"
      extract_frame "$dir/$pfile" "$best" || rm -f "$best"
    fi
  fi
  src=$(find_preview "$dir") || { note "no preview image in $dir; skipped"; return 1; }
  # Animated previews still need a frame extracted, but NOT into the cache:
  # a preview-derived frame is as small as the preview, and a cache entry
  # would block the full-res live capture forever. Extract straight to the
  # destination; an owned still already there is kept as-is (it may carry
  # an upgraded capture).
  if [[ ! -f $best && ${src,,} == *.gif ]]; then
    dst=$BG_DIR/we-$id.jpg
    name=${dst##*/}
    if [[ -n ${OWNED[$name]:-} && -f $dst ]]; then
      printf '%s\n' "$name"
      return 0
    fi
    if [[ -e $dst && -z ${OWNED[$name]:-} ]]; then
      note "keeping your existing $name (not imported)"
      return 1
    fi
    extract_frame "$src" "$dst" \
      || { note "ffmpeg could not extract a frame from $src; skipped $id"; return 1; }
    [[ -s $dst && -f $dst ]] || { note "no usable still at $dst; skipped $id"; return 1; }
    printf '%s\n' "$name"
    return 0
  fi
  if [[ -f $best ]]; then
    # An already-imported still is kept under its name and never relinked to
    # the preview; when the cached frame is newer (fresh extraction, or a
    # capture that landed while the sync was not looking), it is copied over
    # the still in place. cp -p equalizes mtimes, so this is one-shot.
    old=${OLD_BY_ID[$id]:-}
    if [[ -n $old && -f $BG_DIR/$old ]]; then
      if [[ $best -nt $BG_DIR/$old ]]; then
        # Replace via temp + mv: the still may be a hardlink to Steam's own
        # preview file (import links when it can), and cp would write through
        # the shared inode, corrupting Steam's copy. mv swaps the directory
        # entry and leaves the old inode untouched.
        cp -p "$best" "$BG_DIR/$old.tmp.$$" 2>/dev/null \
          && mv -f "$BG_DIR/$old.tmp.$$" "$BG_DIR/$old" 2>/dev/null \
          || { rm -f "$BG_DIR/$old.tmp.$$"; note "could not upgrade $old from the cached frame"; }
      fi
      printf '%s\n' "$old"
      return 0
    fi
    src=$best
  fi
  ext=${src##*.}
  dst=$BG_DIR/we-$id.${ext,,}
  name=${dst##*/}
  if [[ -e $dst && -z ${OWNED[$name]:-} && ! $dst -ef $src ]]; then
    note "keeping your existing $name (not imported)"
    return 1
  fi
  # Hardlink so the grid's selected-highlight (-samefile) matches; copy
  # across filesystems. Skip when already linked to this source.
  # -T: a directory squatting at $dst must fail, not receive the link or
  # copy inside itself.
  [[ $dst -ef $src ]] || ln -fT "$src" "$dst" 2>/dev/null || cp -fT "$src" "$dst" 2>/dev/null \
    || { note "could not write $dst; skipped $id"; return 1; }
  # Belt and braces: never report (or manifest) a still that is not a file.
  [[ -s $dst && -f $dst ]] || { note "no usable still at $dst; skipped $id"; return 1; }
  printf '%s\n' "$name"
}

do_import() {
  local remove= refresh=
  case ${1:-} in
  --remove) remove=1; shift ;;
  --refresh) refresh=1; shift ;;
  esac
  local ids=()
  local arg
  for arg in "$@"; do
    [[ $arg =~ ^[0-9]+$ ]] || { usage >&2; fail "import takes workshop ids, got: $arg"; }
    ids+=("$arg")
  done

  local old_mode= old_entries=()
  declare -A OWNED=() OLD_BY_ID=()
  if [[ -f $WE_MANIFEST ]]; then
    old_mode=$(head -n1 "$WE_MANIFEST")
    mapfile -t old_entries < <(manifest_entries)
    local e
    for e in ${old_entries[@]+"${old_entries[@]}"}; do
      OWNED[$e]=1
      [[ $e =~ ^we-([0-9]+)\. ]] && OLD_BY_ID[${BASH_REMATCH[1]}]=$e
    done
  fi

  # Explicitly requested ids must exist, whatever the mode; a refresh may
  # silently drop vanished projects, a typed id may not.
  if [[ -z $remove ]]; then
    local rid
    for rid in ${ids[@]+"${ids[@]}"}; do
      [[ -d $WE_WORKSHOP_DIR/$rid ]] || fail "workshop project not installed: $rid"
    done
  fi

  if [[ -n $remove ]]; then
    [[ -f $WE_MANIFEST ]] || { note "nothing imported; nothing to remove"; return 0; }
    if [[ ${#ids[@]} -eq 0 ]]; then
      remove_entries ${old_entries[@]+"${old_entries[@]}"}
      rm -f "$WE_MANIFEST"
      rmdir "$BG_DIR" 2>/dev/null || true
      # Removing the collection is the opt-out: without stills the launcher
      # has nothing to serve, and a running instance must not linger.
      systemctl --user disable --now omarchy-we.service 2>/dev/null || true
      systemctl --user disable --now omarchy-we-import.path 2>/dev/null || true
      rm -f "$HOME/.local/state/omarchy/matugen-auto.we"
      note "removed all imported Wallpaper Engine stills"
    else
      local kept=() name id match
      for name in "${old_entries[@]}"; do
        match=
        for id in "${ids[@]}"; do
          [[ $name == we-$id.* ]] && match=1 && break
        done
        if [[ -n $match ]]; then remove_entries "$name"; else kept+=("$name"); fi
      done
      # Pruning ids from an "all" collection makes it a selection, or the
      # next refresh would bring them straight back.
      write_manifest selected ${kept[@]+"${kept[@]}"}
      note "removed ${#ids[@]} entr$( ((${#ids[@]} == 1)) && echo y || echo ies); ${#kept[@]} kept"
    fi
    return 0
  fi

  # --refresh (install.sh rerun): re-sync per the recorded mode; a machine
  # that never imported stays WE-free.
  if [[ -n $refresh && ! -f $WE_MANIFEST ]]; then
    return 0
  fi

  # Build the target id set.
  local mode targets=()
  if [[ -n $refresh ]]; then
    mode=$old_mode
  elif [[ ${#ids[@]} -gt 0 ]]; then
    # Selected import extends an earlier selection; an "all" collection
    # already covers every id.
    mode=${old_mode:-selected}
    [[ $mode == all ]] \
      && note "collection is set to import all projects; the listed ids are covered by the refresh"
  else
    mode=all
  fi
  if [[ $mode == all ]]; then
    [[ -d $WE_WORKSHOP_DIR ]] \
      || fail "workshop dir not found: $WE_WORKSHOP_DIR (set WE_WORKSHOP_DIR, or subscribe to wallpapers in Steam first)"
    # Steam's manifest is the source of truth when it is readable: content
    # dirs of unsubscribed wallpapers linger until Steam garbage-collects
    # them and must not stay in the picker. Only ever an intersection -
    # importing needs the files on disk either way.
    local subs=
    subs=$(subscribed_ids) || subs=
    declare -A SUBSCRIBED=()
    local s
    for s in $subs; do SUBSCRIBED[$s]=1; done
    local d skipped=0
    for d in "$WE_WORKSHOP_DIR"/*/; do
      [[ -d $d ]] || continue
      d=${d%/}
      [[ ${d##*/} =~ ^[0-9]+$ ]] || continue
      if [[ -n $subs && -z ${SUBSCRIBED[${d##*/}]:-} ]]; then
        skipped=$((skipped + 1))
        continue
      fi
      targets+=("${d##*/}")
    done
    ((skipped > 0)) && note "skipped $skipped unsubscribed project$( ((skipped == 1)) || echo s) still on disk"
    [[ ${#targets[@]} -gt 0 ]] || fail "no workshop projects found in $WE_WORKSHOP_DIR"
  else
    # Previously imported ids (from manifest basenames) plus new ones.
    local name id
    for name in "${old_entries[@]}"; do
      [[ $name =~ ^we-([0-9]+)\. ]] && targets+=("${BASH_REMATCH[1]}")
    done
    for id in ${ids[@]+"${ids[@]}"}; do
      local seen=
      for name in ${targets[@]+"${targets[@]}"}; do [[ $name == "$id" ]] && seen=1 && break; done
      [[ -z $seen ]] && targets+=("$id")
    done
    # An emptied selection (everything pruned) is a valid state on refresh.
    [[ ${#targets[@]} -gt 0 ]] || { [[ -n $refresh ]] && return 0; fail "nothing to import"; }
  fi

  mkdir -p "$BG_DIR"
  local new_entries=() id name
  for id in "${targets[@]}"; do
    if name=$(import_one "$id"); then
      new_entries+=("$name")
    elif [[ ${#ids[@]} -gt 0 ]]; then
      # Explicitly requested ids must exist; silent skips are for refreshes.
      local wanted
      for wanted in "${ids[@]}"; do
        [[ $wanted == "$id" ]] && fail "workshop project not installed: $id"
      done
    fi
  done

  # Drop only OUR stale stills: listed before, gone from the target set now
  # (unsubscribed, or the project vanished). User files are never touched.
  local old keep
  for old in ${old_entries[@]+"${old_entries[@]}"}; do
    keep=
    for name in ${new_entries[@]+"${new_entries[@]}"}; do
      [[ $name == "$old" ]] && keep=1 && break
    done
    [[ -z $keep ]] && remove_entries "$old"
  done
  write_manifest "$mode" ${new_entries[@]+"${new_entries[@]}"}
  note "imported ${#new_entries[@]} Wallpaper Engine wallpaper$( ((${#new_entries[@]} == 1)) || echo s) into $BG_DIR"

  # Importing is the opt-in: enable the launcher unit so a picked WE
  # wallpaper starts (and survives reboots). install.sh ships the unit but
  # never enables it; --refresh stays passive too.
  if [[ -z $refresh ]]; then
    if [[ -f $HOME/.config/systemd/user/omarchy-we.service ]]; then
      systemctl --user enable omarchy-we.service 2>/dev/null \
        || note "could not enable omarchy-we.service; enable it manually"
    else
      note "omarchy-we.service not installed; rerun install.sh, then import again"
    fi
    # Keep the collection following the Steam subscription list: watch the
    # workshop dir and re-refresh on subscribe/unsubscribe.
    if [[ -f $HOME/.config/systemd/user/omarchy-we-import.path ]]; then
      systemctl --user enable --now omarchy-we-import.path 2>/dev/null \
        || note "could not enable omarchy-we-import.path; new subscriptions need a manual import"
    fi
    note "pick them in the wallpaper menu (SUPER+CTRL+SPACE) with the matugen-auto theme active"
    # Scenes only get a full-res still after their first launch; offer the
    # warm pass when any imported wallpaper is still waiting for a frame.
    local missing=0 n
    for n in ${new_entries[@]+"${new_entries[@]}"}; do
      [[ $n =~ ^we-([0-9]+)\. && ! -f $SHOTS/${BASH_REMATCH[1]}.jpg ]] && missing=$((missing + 1))
    done
    ((missing > 0)) \
      && note "optional: 'omarchy-auto-theme-we capture' pre-renders full-res frames for $missing wallpaper$( ((missing == 1)) || echo s) (first picks look sharp then)"
  fi

  # Warm the native picker: generate any missing thumbnails now (the
  # switcher otherwise does it synchronously on first open, which stalls
  # the grid for a large collection) and hand the rows to the shell so the
  # first open after an import is instant. Same dir pair, same order as
  # omarchy-theme-bg-switcher, or the rows cache key will not match.
  if command -v omarchy-menu-images >/dev/null; then
    local theme_bgs="$HOME/.local/state/omarchy/current/theme/backgrounds"
    omarchy-menu-images --cache-only "$theme_bgs" "$BG_DIR" >/dev/null 2>&1 || true
    omarchy-menu-images --preload "$theme_bgs" "$BG_DIR" >/dev/null 2>&1 || true
  fi
  return 0
}

# --- capture: pre-render full-res frames for every imported wallpaper ------
# Scene wallpapers can only get a real frame by running; without this, the
# first pick of each scene starts from the low-res preview (later picks are
# sharp, since the first launch captures). One warm pass makes even first
# picks sharp.
do_capture() {
  [[ $# -eq 0 ]] || { usage >&2; exit 2; }
  [[ -f $WE_MANIFEST ]] || fail "nothing imported yet; run: omarchy-auto-theme-we import"
  command -v linux-wallpaperengine >/dev/null || fail "linux-wallpaperengine not found on PATH"
  local WE_SCREENS= WE_FLAGS= WE_LAUNCH= screen
  # shellcheck source=/dev/null
  [[ -f $SETTINGS ]] && source "$SETTINGS"
  screen=${WE_SCREENS%% *}
  if [[ -z $screen ]]; then
    command -v hyprctl >/dev/null && command -v jq >/dev/null \
      || fail "hyprctl and jq are needed to pick an output; set WE_SCREENS in $SETTINGS"
    screen=$(hyprctl monitors -j | jq -r '.[0].name // empty')
  fi
  [[ -n $screen ]] || fail "no output found; set WE_SCREENS in $SETTINGS"

  local todo=() name id
  while IFS= read -r name; do
    [[ $name =~ ^we-([0-9]+)\. ]] || continue
    id=${BASH_REMATCH[1]}
    [[ -f $SHOTS/$id.jpg ]] && continue
    [[ -d $WE_WORKSHOP_DIR/$id ]] || continue
    todo+=("$id")
  done < <(manifest_entries)
  if [[ ${#todo[@]} -eq 0 ]]; then
    note "all imported wallpapers already have full-res frames"
    return 0
  fi

  # The warm pass drives the screen itself; the managed instance would
  # fight it for the layer surface.
  local was_active=
  if systemctl --user is-active --quiet omarchy-we.service 2>/dev/null; then
    was_active=1
    systemctl --user stop omarchy-we.service 2>/dev/null || true
  fi
  mkdir -p "$SHOTS"
  note "capturing ${#todo[@]} wallpaper$( ((${#todo[@]} == 1)) || echo s), ~10s each; the desktop background will cycle"
  local pid shot
  for id in "${todo[@]}"; do
    shot=$SHOTS/$id.jpg
    linux-wallpaperengine --screen-root "$screen" --bg "$id" \
      --silent --fps 30 --disable-mouse \
      --screenshot "$shot" --screenshot-delay 90 >/dev/null 2>&1 &
    pid=$!
    # An incompatible scene can crash WE outright; without disown, bash
    # reports the signal ("Segmentation fault") into our output.
    disown "$pid" 2>/dev/null || true
    # Wait for the capture to appear AND stop growing: killing WE the
    # moment the file exists races its write and leaves a torn JPEG.
    local prev=-1 size
    for _ in {1..40}; do
      size=$(stat -c %s "$shot" 2>/dev/null || echo -1)
      [[ $size -gt 0 && $size == "$prev" ]] && break
      prev=$size
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    kill "$pid" 2>/dev/null || true
    # CEF helpers can outlive the parent; wait for the layer surface to be
    # released before the next launch. (No wait: the pid is disowned.)
    if pkill -x "$WE_PROC" 2>/dev/null; then
      for _ in {1..50}; do
        pgrep -x "$WE_PROC" >/dev/null 2>&1 || break
        sleep 0.1
      done
    fi
    if [[ -s $shot ]]; then
      note "captured $id"
    else
      rm -f "$shot"
      note "no frame for $id (the wallpaper may not render on this machine)"
    fi
  done
  if [[ -n $was_active ]]; then
    systemctl --user start omarchy-we.service 2>/dev/null || true
  fi

  # Apply the new frames to the imported stills; the sync run re-renders
  # the palette if the current background was among them.
  do_import --refresh
  systemctl --user --no-block start omarchy-matugen.service 2>/dev/null || true
  return 0
}

# --- --exec-current: launch WE for the current background (unit ExecStart) --
do_exec_current() {
  local bg base id
  bg=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null || true)
  base=${bg##*/}
  [[ $base =~ ^we-([0-9]+)\.[A-Za-z0-9]+$ ]] || exit 0
  # Only stills our manifest lists are live-wallpaper picks: a user's own
  # file at a we-<id> name (import refuses to touch those) is a static
  # wallpaper like any other.
  manifest_entries | grep -qxF -- "$base" || exit 0
  id=${BASH_REMATCH[1]}
  [[ -d $WE_WORKSHOP_DIR/$id ]] \
    || { note "workshop project $id not installed; static wallpaper stays"; exit 0; }

  # User tuning: a trusted bash fragment sourced as-is (same file the sync
  # script reads). Recognized here:
  #   WE_FLAGS    extra linux-wallpaperengine flags
  #   WE_SCREENS  space-separated outputs (default: all, via hyprctl)
  #   WE_LAUNCH   full launch command override, %id substituted
  local WE_FLAGS="--silent --fps 30 --disable-mouse" WE_SCREENS= WE_LAUNCH=
  # shellcheck source=/dev/null
  [[ -f $SETTINGS ]] && source "$SETTINGS"
  # Flag/name charsets (no shell metacharacters); a space in an unquoted
  # regex breaks [[ ]] tokenization, hence the variables.
  # / and + are legitimate in flag values (--assets-dir /opt/we); word-split
  # via read -ra and never evaluated, so neither is a shell hazard.
  local flags_re='^[A-Za-z0-9_=,.:/+ -]*$' screens_re='^[A-Za-z0-9_ -]*$'
  [[ $WE_FLAGS =~ $flags_re ]] \
    || { echo "omarchy-auto-theme-we: invalid WE_FLAGS in $SETTINGS" >&2; exit 2; }
  [[ $WE_SCREENS =~ $screens_re ]] \
    || { echo "omarchy-auto-theme-we: invalid WE_SCREENS in $SETTINGS" >&2; exit 2; }

  # The no-lock-in escape hatch: users driving WE their own way replace the
  # whole launch. The settings file is trusted code already, so this runs
  # through bash unrestricted.
  if [[ -n $WE_LAUNCH ]]; then
    exec bash -c "${WE_LAUNCH//%id/$id}"
  fi

  command -v linux-wallpaperengine >/dev/null \
    || fail "linux-wallpaperengine not found on PATH"
  if [[ -z $WE_SCREENS ]]; then
    command -v hyprctl >/dev/null || fail "hyprctl not found; set WE_SCREENS in $SETTINGS"
    command -v jq >/dev/null || fail "jq not found; install it or set WE_SCREENS in $SETTINGS"
    WE_SCREENS=$(hyprctl monitors -j | jq -r '.[].name' | tr '\n' ' ') \
      || fail "could not list monitors; set WE_SCREENS in $SETTINGS"
  fi
  local args=() screen flags=()
  # One process drives all monitors, same wallpaper on each (omarchy's own
  # one-image-for-all model).
  for screen in $WE_SCREENS; do
    args+=(--screen-root "$screen" --bg "$id")
  done
  [[ ${#args[@]} -gt 0 ]] || fail "no outputs found; set WE_SCREENS in $SETTINGS"
  if [[ ! -f $SHOTS/$id.jpg ]]; then
    # First launch of this wallpaper: capture one full-res frame a few
    # seconds in (past the fade-in), so the sync script can upgrade the
    # low-res preview still. WE keeps rendering after the capture
    # (verified against r627 on 2026-08-28).
    mkdir -p "$SHOTS"
    args+=(--screenshot "$SHOTS/$id.jpg" --screenshot-delay 90)
  fi
  read -ra flags <<<"$WE_FLAGS"
  exec linux-wallpaperengine ${flags[@]+"${flags[@]}"} "${args[@]}"
}

# --- argument dispatch ------------------------------------------------------
[[ ${1:-} == -h || ${1:-} == --help ]] && { usage; exit 0; }
[[ $# -ge 1 ]] || { usage >&2; exit 2; }
case $1 in
import)
  shift
  do_import "$@"
  exit 0
  ;;
capture)
  shift
  do_capture "$@"
  exit 0
  ;;
--exec-current)
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  do_exec_current
  ;;
esac

target=$1
shift
launch=()
if [[ ${1:-} == -- ]]; then
  shift
  # A bare `--` signals intent to relaunch; an empty command is a typo.
  [[ $# -ge 1 ]] || { usage >&2; exit 2; }
  launch=("$@")
elif [[ $# -gt 0 ]]; then
  usage >&2
  exit 2
fi

command -v omarchy-matugen-sync >/dev/null \
  || fail "omarchy-matugen-sync not found on PATH; rerun install.sh"

# Resolve the target to a source file. A local file or directory wins over a
# workshop id of the same name; explicit paths beat implicit lookups.
src=
dir=
if [[ -f $target ]]; then
  src=$target
elif [[ -d $target ]]; then
  dir=$target
elif [[ $target =~ ^[0-9]+$ && -d $WE_WORKSHOP_DIR/$target ]]; then
  dir=$WE_WORKSHOP_DIR/$target
else
  fail "not a file, directory, or installed workshop id: $target"
fi
if [[ -z $src ]]; then
  src=$(find_preview "$dir") \
    || fail "no preview image (preview.jpg/png/gif/...) found in $dir"
fi

# Matugen needs a still image; animated sources get a representative frame.
case ${src,,} in
*.jpg | *.jpeg | *.png | *.webp | *.bmp)
  img=$src
  ;;
*)
  command -v ffmpeg >/dev/null \
    || fail "ffmpeg is needed to extract a frame from $src (install it, or pass a still image)"
  mkdir -p "${FRAME%/*}"
  extract_frame "$src" "$FRAME" \
    || fail "ffmpeg could not extract a frame from $src"
  img=$FRAME
  ;;
esac

omarchy-matugen-sync --image "$img"

if [[ ${#launch[@]} -gt 0 ]]; then
  # Wallpaper Engine on Linux has no "switch" operation: changing the live
  # wallpaper is stop + relaunch. SIGTERM is asynchronous; wait for the old
  # instance to release its layer-shell surface before the replacement.
  if pkill -x "$WE_PROC" 2>/dev/null; then
    for _ in {1..50}; do
      pgrep -x "$WE_PROC" >/dev/null 2>&1 || break
      sleep 0.1
    done
  fi
  exec "${launch[@]}"
fi
