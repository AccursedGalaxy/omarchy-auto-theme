#!/bin/bash
# Regenerate the matugen-auto quattro theme from the current wallpaper.
# Triggered by omarchy-matugen.path whenever omarchy's current/ state changes.
# Run with --diagnose to check the whole pipeline without changing anything.
set -euo pipefail

# systemd user units inherit a minimal PATH: pin everything this script calls.
# ~/.local/bin must precede the omarchy bin dir so local shims
# (e.g. omarchy-theme-set-tmux) win here too.
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$HOME/.local/bin:$OMARCHY_PATH/bin:/usr/local/bin:/usr/bin:$PATH"

STATE_DIR="$HOME/.local/state/omarchy"
LAST_FILE="$STATE_DIR/matugen-auto.last"
THEME_DIR="$HOME/.config/omarchy/themes/matugen-auto"
CONFIG="$HOME/.config/matugen/omarchy-auto-theme.toml"

# User tuning lives in the settings file, not in this script — installs and
# upgrades overwrite this file unconditionally. The file is a trusted bash
# fragment sourced as-is; recognized variables:
#   PREFER  matugen source-color preference (default: saturation)
#   MODE    dark or light (default: dark)
SETTINGS="$HOME/.config/omarchy-auto-theme/settings"
PREFER=saturation
MODE=dark
# shellcheck source=/dev/null
[[ -f $SETTINGS ]] && source "$SETTINGS"
case $MODE in dark|light) ;; *) echo "omarchy-matugen-sync: invalid MODE '$MODE' in $SETTINGS (dark|light)" >&2; exit 2 ;; esac
[[ $PREFER =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "omarchy-matugen-sync: invalid PREFER '$PREFER' in $SETTINGS" >&2; exit 2; }

diagnose() {
  local ok=0
  check() { # label, condition-command...
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then echo "ok    $label"; else echo "FAIL  $label"; ok=1; fi
  }
  check "matugen on PATH"                       command -v matugen
  check "omarchy-theme-refresh on PATH"         command -v omarchy-theme-refresh
  check "matugen config: $CONFIG"               test -s "$CONFIG"
  check "config renders the omarchy_quattro template" grep -q '^\[templates\.omarchy_quattro\]' "$CONFIG"
  check "template: ~/.config/matugen/templates/omarchy-quattro-colors.toml" test -s "$HOME/.config/matugen/templates/omarchy-quattro-colors.toml"
  check "theme output dir writable: $THEME_DIR" test -w "$THEME_DIR"
  check "omarchy state dir: $STATE_DIR/current" test -d "$STATE_DIR/current"
  check "current wallpaper resolves"            test -f "$(readlink -f "$STATE_DIR/current/background" 2>/dev/null || echo /nonexistent)"
  check "watcher unit active (omarchy-matugen.path)" systemctl --user is-active omarchy-matugen.path
  # The distributed template emits mode = "{{mode}}", which always follows the
  # settings MODE. A customized template may hardcode a literal mode instead —
  # catch the half-configured state where it disagrees with settings.
  check "settings MODE matches template mode" \
    grep -qE "^mode = \"(\\{\\{mode\\}\\}|$MODE)\"" "$HOME/.config/matugen/templates/omarchy-quattro-colors.toml"
  echo "active theme: $(cat "$STATE_DIR/current/theme.name" 2>/dev/null || echo '(none)')"
  echo "matugen: $(matugen --version 2>/dev/null || echo '(not found)')"
  echo "settings: mode=$MODE prefer=$PREFER ($([[ -f $SETTINGS ]] && echo "$SETTINGS" || echo built-in defaults))"
  exit "$ok"
}
[[ ${1:-} == --diagnose ]] && diagnose

# Only act while the adaptive theme is active.
theme_name=$(cat "$STATE_DIR/current/theme.name" 2>/dev/null || true)
slug=$(echo "$theme_name" | tr '[:upper:] ' '[:lower:]-')
[[ $slug == matugen-auto ]] || exit 0

bg=$(readlink -f "$STATE_DIR/current/background" 2>/dev/null || true)
[[ -n $bg && -f $bg ]] || exit 0

# Idempotency guard: theme refresh rewrites current/ without changing the
# wallpaper, which re-triggers the path unit — bail unless the image changed.
# Fingerprint is path + size + nanosecond mtime, so an image edited or
# replaced in place still counts as a change even within the same second.
fingerprint="$bg $(stat -c '%s %.Y' "$bg" 2>/dev/null || true)"
[[ $fingerprint == "$(cat "$LAST_FILE" 2>/dev/null || true)" ]] && exit 0

[[ -s $CONFIG ]] || { echo "omarchy-matugen-sync: missing $CONFIG — rerun install.sh" >&2; exit 1; }
matugen image "$bg" --config "$CONFIG" --mode "$MODE" --prefer "$PREFER"

# Re-render every omarchy template (shell, neovim, terminal OSC, ...) from the
# freshly generated colors.toml. Runs with OMARCHY_THEME_SKIP_BACKGROUND=1
# internally, so it does not loop back into this script.
omarchy-theme-refresh

# Commit the fingerprint only after the whole pipeline succeeded (set -e gets
# us here only on success): a failed matugen or refresh must retry on the next
# trigger, not be recorded as done. Atomic write so a crash mid-write can at
# worst cost one redundant regeneration.
printf '%s\n' "$fingerprint" >"$LAST_FILE.tmp.$$"
mv -f "$LAST_FILE.tmp.$$" "$LAST_FILE"
